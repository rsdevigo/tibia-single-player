# Copie para .env e ajuste.
SERVER_IP=192.168.0.10      # IP do CasaOS na rede local
DB_ROOT_PASS=troque-isto
DB_NAME=canary
DB_USER=canary
DB_PASS=troque-isto
BOT_PLAYERS_ONLINE=100      # 0 a ~997; menos = menos RAM/CPU
CANARY_BOTS_VERSION=v2026.10.24.1
DATA_DIR=./data             # no CasaOS: /DATA/AppData/tibia-single-player
WEB_PORT=8080               # porta do MyAAC/login.php
MYAAC_INSTALL_IPS=          # IP(s) do seu navegador liberados no /install do MyAAC (ver logs do web)
